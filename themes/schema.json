{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/TalesRamosDev/cursor-studio-themes/main/themes/schema.json",
  "title": "Theme metadata",
  "description": "Metadata for one Cursor Studio theme, stored as themes/<slug>/theme.json.",
  "type": "object",
  "required": ["slug", "name", "author", "description", "version", "license", "cursors"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Folder name. Unique, lowercase, hyphenated."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "description": "Name shown in the app."
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "GitHub handle or display name of the author."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One or two sentences. Shown under the name in the app."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version. Bump on every published change."
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier, for example MIT or CC-BY-4.0."
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 20 },
      "description": "Free-form tags used for filtering and search."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Optional link to the original theme page."
    },
    "preview": {
      "type": "string",
      "description": "Path to the preview image, relative to the theme folder.",
      "default": "preview.png"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Colour used for the theme card accent in the app."
    },
    "cursors": {
      "type": "array",
      "minItems": 1,
      "description": "Every cursor file the theme provides.",
      "items": {
        "type": "object",
        "required": ["file", "role"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "\\.(ani|cur)$",
            "description": "File name inside the cursors/ folder."
          },
          "role": {
            "type": "string",
            "enum": [
              "Arrow",
              "Help",
              "AppStarting",
              "Wait",
              "Crosshair",
              "IBeam",
              "NWPen",
              "No",
              "SizeNS",
              "SizeWE",
              "SizeNWSE",
              "SizeNESW",
              "SizeAll",
              "UpArrow",
              "Hand",
              "Pin",
              "Person"
            ],
            "description": "Windows cursor role this file fills."
          }
        }
      }
    }
  }
}
