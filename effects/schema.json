{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/charset404/cursor-studio-themes/main/effects/schema.json",
  "title": "Effect metadata",
  "description": "Metadata for one Cursor Studio click effect, stored as effects/<slug>/effect.json.",
  "type": "object",
  "required": [
    "slug",
    "name",
    "author",
    "description",
    "version",
    "license",
    "effect"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Folder name. Unique, lowercase, hyphenated."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "description": "Name shown in the app."
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "GitHub handle or display name of the author."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One or two sentences. Shown under the name in the app."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version. Bump on every published change."
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier, for example MIT or CC-BY-4.0."
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 20
      },
      "description": "Free-form tags used for filtering and search."
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Id de uma categoria de categories.json. Ausente ou desconhecido cai em Outros."
    },
    "preview": {
      "type": "string",
      "description": "Path to the preview image, relative to the theme folder.",
      "default": "preview.png"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Colour used for the theme card accent in the app."
    },
    "links": {
      "type": "array",
      "description": "Vínculos opcionais cursor ↔ efeito. Basta um lado declarar; o app só oferece instalar.",
      "items": {
        "type": "object",
        "required": [
          "slug"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "relation": {
            "enum": [
              "requires",
              "recommends"
            ],
            "default": "recommends"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "file",
        "frames",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.bgra$",
          "description": "Único arquivo .bgra, dentro da pasta do efeito."
        },
        "frames": {
          "type": "integer",
          "minimum": 8,
          "maximum": 60
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "Igual a width: o quadro é quadrado."
        }
      }
    }
  }
}
